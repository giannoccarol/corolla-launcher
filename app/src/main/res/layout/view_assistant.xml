<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the assistant panel: what was heard, the reply, a big microphone and a way to type. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/heard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="17sp"
        android:visibility="gone"
        tools:text="Portami a casa"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/reply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="?attr/fontMedium"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        tools:text="Ok, ti porto a casa." />

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="invalid x-api-key"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_marginTop="18dp">

        <View
            android:id="@+id/micHalo"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center"
            android:alpha="0.25"
            android:background="@drawable/bg_round_accent" />

        <ImageButton
            android:id="@+id/mic"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_round_accent"
            android:contentDescription="@string/assistant_talk"
            android:scaleType="center"
            android:src="@drawable/ic_mic_large"
            app:tint="@color/on_accent" />
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        tools:text="Tap the microphone and speak" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/type"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="?attr/fontMedium"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/assistant_type"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="?attr/fontMedium"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/assistant_open_settings"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
