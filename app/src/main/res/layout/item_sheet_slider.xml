<?xml version="1.0" encoding="utf-8"?>
<!-- A volume or brightness control: big minus and plus buttons around a thick slider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_row"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            app:tint="@color/text_primary"
            tools:src="@drawable/ic_volume" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="?attr/fontMedium"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            tools:text="Media" />

        <TextView
            android:id="@+id/value"
            android:fontFeatureSettings="tnum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/fontMedium"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            tools:text="12" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/minus"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_round"
            android:contentDescription="@string/slider_less"
            android:scaleType="center"
            android:src="@drawable/ic_minus"
            app:tint="@color/text_primary" />

        <SeekBar
            android:id="@+id/slider"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:maxHeight="16dp"
            android:minHeight="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:progressDrawable="@drawable/seekbar_track"
            android:splitTrack="false"
            android:thumb="@drawable/seekbar_thumb"
            android:thumbOffset="0dp" />

        <ImageButton
            android:id="@+id/plus"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_round"
            android:contentDescription="@string/slider_more"
            android:scaleType="center"
            android:src="@drawable/ic_plus"
            app:tint="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
