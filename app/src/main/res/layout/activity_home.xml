<?xml version="1.0" encoding="utf-8"?>
<!-- The home dashboard, laid out for a short side of 460-600 dp (see ui/UiScale): top bar, three
     flexible columns (media and favourites, car and speed, quick settings), bottom bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top bar: driver, tabs, status icons, date and time. Its id makes LauncherActivity
         drive the status icons. -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/keyBack"
            android:layout_width="52dp"
            android:layout_height="@dimen/home_top_bar_height"
            android:background="@drawable/bg_touch"
            android:contentDescription="@string/back"
            android:scaleType="center"
            android:src="@drawable/ic_nav_back"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/keyHome"
            android:layout_width="52dp"
            android:layout_height="@dimen/home_top_bar_height"
            android:background="@drawable/bg_touch"
            android:contentDescription="@string/nav_key_home"
            android:scaleType="center"
            android:src="@drawable/ic_nav_home"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/keyRecents"
            android:layout_width="52dp"
            android:layout_height="@dimen/home_top_bar_height"
            android:background="@drawable/bg_touch"
            android:contentDescription="@string/nav_key_recents"
            android:scaleType="center"
            android:src="@drawable/ic_nav_recents"
            app:tint="@color/text_primary" />

        <View
            android:id="@+id/keysDivider"
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/c_line" />

        <LinearLayout
            android:id="@+id/tabNavigation"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_touch"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_gps"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/tab_navigation"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/assistantButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill_accent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic"
                app:tint="@color/on_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="?attr/fontMedium"
                android:text="@string/assistant_title"
                android:textColor="@color/on_accent"
                android:textSize="15sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/statusGps"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_gps"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/statusBluetooth"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bluetooth"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/statusNetwork"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_wifi"
            app:tint="@color/text_primary" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="?attr/c_line" />

        <TextClock
            android:id="@+id/statusDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Tue 10 Nov" />

        <TextClock
            android:id="@+id/statusTime"
            android:fontFeatureSettings="tnum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="?attr/fontMedium"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            tools:text="15:47" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- Media player and favourites -->
        <LinearLayout
            android:id="@+id/centerColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="125"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/mediaCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <HorizontalScrollView
                    android:id="@+id/sourcesScroll"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/sources"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/mediaContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/cover"
                                android:layout_width="@dimen/cover_size"
                                android:layout_height="@dimen/cover_size"
                                android:background="@drawable/bg_cover"
                                android:contentDescription="@string/media_cover"
                                android:scaleType="centerCrop" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/trackTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="?attr/fontMedium"
                                    android:maxLines="2"
                                    android:textColor="@color/text_primary"
                                    android:textSize="21sp"
                                    tools:text="Track title" />

                                <TextView
                                    android:id="@+id/trackArtist"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="15sp"
                                    tools:text="Artist" />
                            </LinearLayout>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="16dp"
                            android:max="1000"
                            android:progressDrawable="@drawable/progress_media" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/elapsed"
                                android:fontFeatureSettings="tnum"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                tools:text="1:24" />

                            <TextView
                                android:id="@+id/total"
                                android:fontFeatureSettings="tnum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                tools:text="3:52" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mediaEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/emptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="?attr/fontMedium"
                            android:gravity="center"
                            android:text="@string/media_nothing_playing"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/emptyHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/media_nothing_playing_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/emptyAction"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_pill_accent"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="?attr/fontMedium"
                            android:gravity="center"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:text="@string/media_allow"
                            android:textColor="@color/on_accent"
                            android:textSize="15sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/prevButton"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_round"
                        android:contentDescription="@string/media_previous"
                        android:scaleType="center"
                        android:src="@drawable/ic_prev"
                        app:tint="@color/text_primary" />

                    <ImageButton
                        android:id="@+id/playButton"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_marginStart="22dp"
                        android:layout_marginEnd="22dp"
                        android:background="@drawable/bg_round_accent"
                        android:contentDescription="@string/media_play_pause"
                        android:scaleType="center"
                        android:src="@drawable/ic_play"
                        app:tint="@color/on_accent" />

                    <ImageButton
                        android:id="@+id/nextButton"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_round"
                        android:contentDescription="@string/media_next"
                        android:scaleType="center"
                        android:src="@drawable/ic_next"
                        app:tint="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Favourites: four fixed places, one tap calls -->
            <!-- No title: the discs and names say what it is, and the player needs the height. -->
            <LinearLayout
                android:id="@+id/favoritesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/favorites_title"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:id="@+id/favorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <!-- The car: photo and trip computer, speed under it -->
        <LinearLayout
            android:id="@+id/rightColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="100"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/carCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clipToPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/fontMedium"
                        android:text="@string/car_name"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tripState"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="Driving" />
                </LinearLayout>

                <!-- Reaches into the card's side padding (the card does not clip to it): the photo is the
                     card's subject. -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="-10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="-10dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/car_photo_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/car_corolla" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/statDistance"
                        layout="@layout/item_trip_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statDuration"
                        layout="@layout/item_trip_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statAverage"
                        layout="@layout/item_trip_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Speed: a bar graph across the whole panel, big LCD digits under it, heading at
                 the bottom right. -->
            <FrameLayout
                android:id="@+id/speedPanel"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_panel"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <io.github.giannoccarol.corollalauncher.ui.SpeedGauge
                    android:id="@+id/speedGauge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/headingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="?attr/fontMedium"
                        android:gravity="end"
                        android:maxLines="3"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        tools:text="NE" />

                    <TextView
                        android:id="@+id/headingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/speed_heading"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Quick settings: large tiles, two per row -->
        <LinearLayout
            android:id="@+id/quickSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="75"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/qsTheme"
                        layout="@layout/item_quick_tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/qsWifi"
                        layout="@layout/item_quick_tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/qsBluetooth"
                        layout="@layout/item_quick_tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/qsDisplay"
                        layout="@layout/item_quick_tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/qsAudio"
                        layout="@layout/item_quick_tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/qsMore"
                        layout="@layout/item_quick_tile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1" />
                </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/c_line" />

    <!-- Bottom bar: driver name, docked apps around All apps (always centred), volume -->
    <!-- Three zones: the sides share what the apps leave, so the apps stay centred and a long
         name is shortened instead of running under them. -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dock_height"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

        <LinearLayout
            android:id="@+id/driver"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_touch"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/driverInitial"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar"
                android:fontFamily="?attr/fontMedium"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                tools:text="L" />

            <TextView
                android:id="@+id/driverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="?attr/fontMedium"
                android:maxWidth="180dp"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                tools:text="Lorenzo" />
        </LinearLayout>
        </FrameLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


        <LinearLayout
            android:id="@+id/dockLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <ImageButton
            android:id="@+id/allAppsButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_tile"
            android:contentDescription="@string/home_all_apps"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_apps"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:id="@+id/dockRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">


        <ImageButton
            android:id="@+id/volumeDown"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_touch"
            android:contentDescription="@string/volume_down"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_secondary" />

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_volume"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/volumeValue"
                android:fontFeatureSettings="tnum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="?attr/fontMedium"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                tools:text="12" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/volumeUp"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_touch"
            android:contentDescription="@string/volume_up"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
