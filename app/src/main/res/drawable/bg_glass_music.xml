<?xml version="1.0" encoding="utf-8"?>
<!-- Amber player: the glass card with the accent's light rising from the bottom edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_glass_card" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="1.12"
                android:endColor="#00000000"
                android:gradientRadius="75%"
                android:startColor="?attr/c_glow_strong"
                android:type="radial" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>
