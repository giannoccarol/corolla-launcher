<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/fill">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Light from above: a faint top-down sheen, static, drawn once. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="?attr/c_card_highlight" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Hairline edge, so surfaces separate without shadows on a black screen. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="@color/card_border" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
