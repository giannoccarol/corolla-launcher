<?xml version="1.0" encoding="utf-8"?>
<!-- Amber screen: the background colour lit by a warm glow from the bottom right and a faint
     cool (dark) or white (light) one from the top left. Static, drawn once. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/c_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="1.05"
                android:endColor="#00000000"
                android:gradientRadius="90%"
                android:startColor="?attr/c_glow"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.0"
                android:centerY="0.0"
                android:endColor="#00000000"
                android:gradientRadius="70%"
                android:startColor="?attr/c_glow_soft"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
