<?xml version="1.0" encoding="utf-8"?>
<!-- 34dp knob, ringed in the card colour so it stands out from the filled track. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/text_primary" />
    <stroke
        android:width="4dp"
        android:color="@color/accent" />
    <size
        android:width="34dp"
        android:height="34dp" />
</shape>
