<?xml version="1.0" encoding="utf-8"?>
<!-- 34dp white knob with an accent ring: reads as a physical knob in both themes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFFFF" />
    <stroke
        android:width="4dp"
        android:color="@color/accent" />
    <size
        android:width="34dp"
        android:height="34dp" />
</shape>
