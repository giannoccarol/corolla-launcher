<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">
    <item android:id="@+id/fill">
        <shape android:shape="oval">
            <solid android:color="@color/surface_2" />
        </shape>
    </item>
    <!-- Light from above: a faint top-down sheen, static, drawn once. -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="@color/card_highlight" />
        </shape>
    </item>
    <!-- Hairline edge, so surfaces separate without shadows on a black screen. -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="@color/card_border" />
        </shape>
    </item>
</ripple>
