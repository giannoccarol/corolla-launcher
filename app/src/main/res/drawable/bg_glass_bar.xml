<?xml version="1.0" encoding="utf-8"?>
<!-- Amber bottom bar: a floating glass pill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="?attr/c_glass_bottom"
        android:startColor="?attr/c_glass_top" />
    <stroke
        android:width="1dp"
        android:color="?attr/c_card_border" />
    <corners android:radius="200dp" />
</shape>
