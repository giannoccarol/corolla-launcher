<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.x has no adaptive icons: same artwork on a rounded tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/launcher_icon_bg" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:bottom="-12dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="-12dp"
        android:right="-12dp"
        android:top="-12dp" />
</layer-list>
